(
    name: "clean_lowpoly",
    vertex_shader: "assets/shaders/mesh.vert",
    fragment_shader: "assets/shaders/mesh.frag",
    post_fragment_shader: "assets/shaders/post_composite.frag",
    render: (
        resolution_scale: 0.75,
        fixed_resolution: None,
        fog_color: (0.1, 0.1, 0.15),
        fog_start: 8.0,
        fog_end: 30.0,
        color_levels: 256,
        dither_strength: 0.0,
        lighting_mode: VertexLit,
        ambient_color: (0.3, 0.3, 0.35),
        light_dir: (0.4, 0.8, 0.5),
        vertex_snap_amount: 0.0,
        affine_texture_mapping: false,
        texture_filter: Nearest,
        sky_horizon_color: (0.55, 0.65, 0.75),
        sky_zenith_color: (0.1, 0.2, 0.45),
        backface_culling: true,
        hud: (
            anchor_offset: (12.0, 12.0),
            bar_width: 160.0,
            bar_fill_color: (0.3, 0.7, 0.3),
            title_font_size: 20.0,
            toast_color: (1.0, 1.0, 1.0),
        ),
    ),
)